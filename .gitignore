# Godot 4+ specific ignores
.godot/
/android/

# Godot-generated import/export artifacts
*.translation
export.cfg

# Local export build outputs (matches export_presets.cfg's export_path
# values) - build products, not source, and the Windows .exe/.zip alone
# run ~500MB. CI builds these fresh from source; never commit them.
/builds/
/HomesteadDefense.exe
/HomesteadDefense.console.exe
/HomesteadDefense.zip
/HomesteadDefense.x86_64
*.pck

# Asset packs ship the same models in gltf/fbx/obj; this project only ever
# uses gltf/glb, and some KayKit obj sidecar filenames exceed Windows' path
# length limit (compound parent-child names), which breaks `git add`.
docs/assets/**/Assets/obj/
docs/assets/**/Assets/fbx/
docs/assets/**/Assets/fbx(unity)/
